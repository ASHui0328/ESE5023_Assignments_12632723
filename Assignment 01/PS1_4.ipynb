   "source": [
    "# 4 Add or double\n",
    "def Least_moves(x):\n",
    "    n = 0\n",
    "    while x > 1:\n",
    "        if x % 2 == 0:\n",
    "            x = x / 2\n",
    "            n = n + 1\n",
    "        else:\n",
    "            x = (x - 1) / 2\n",
    "            n = n + 2\n",
    "    return n\n",
    "\n",
    "print(Least_moves(2))\n",
    "print(Least_moves(5))"
   ]
  }
 ],
